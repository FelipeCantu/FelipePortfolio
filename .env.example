# Copy to .env.local and fill in. Never commit real values.

# EmailJS — contact form (client-side, prefix must be NEXT_PUBLIC_)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_REPLY_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# EmailJS — Get Started intake wizard
NEXT_PUBLIC_INTAKE_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_INTAKE_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_INTAKE_EMAILJS_PUBLIC_KEY=

# Stripe & Admin (server-side only — no NEXT_PUBLIC_ prefix)
STRIPE_SECRET_KEY=
ADMIN_SECRET=
